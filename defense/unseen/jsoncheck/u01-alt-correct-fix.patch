---
 cJSON.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/cJSON.c b/cJSON.c
index b9ae041..f7cc161 100644
--- a/cJSON.c
+++ b/cJSON.c
@@ -657,7 +657,8 @@ static cJSON_bool parse_string(cJSON * const item, parse_buffer * const input_bu
         /* calculate approximate size of the output (overestimate) */
         size_t allocation_length = 0;
         size_t skipped_bytes = 0;
-        while ((*input_end != '\"') && ((size_t)(input_end - input_buffer->content) < input_buffer->length))
+        const unsigned char *const buffer_end = input_buffer->content + input_buffer->length;
+        while ((input_end < buffer_end) && (*input_end != '\"'))
         {
             /* is escape sequence */
             if (input_end[0] == '\\')
@@ -672,7 +673,7 @@ static cJSON_bool parse_string(cJSON * const item, parse_buffer * const input_bu
             }
             input_end++;
         }
-        if (*input_end != '\"')
+        if ((input_end >= buffer_end) || (*input_end != '\"'))
         {
             goto fail; /* string ended unexpectedly */
         }
